# Review Desk — copy to .env.local for local development.
# Never commit real keys. On Vercel, set the same names under
# Project → Settings → Environment Variables (then Redeploy).

# Required for Claude reviews. Without this, /api/evaluate uses the rule-based simulator (source: "rules").
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6
